# ===== my_jevis 后端环境变量 =====
# 复制本文件为 .env 并填入真实值。.env 已被 .gitignore 忽略，不会提交。

# --- 生成模型（DeepSeek）---
DEEPSEEK_API_KEY=sk-你的deepseek_key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# --- Embedding（硅基流动 SiliconFlow）---
EMBEDDING_API_KEY=sk-你的硅基流动_key
EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_MODEL=BAAI/bge-m3

# --- MySQL ---
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=你的mysql密码
MYSQL_DATABASE=my_jevis

# --- JWT ---
JWT_SECRET_KEY=replace-with-random-string-at-least-32-chars
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

# --- ChromaDB 本地持久化目录 ---
CHROMA_DIR=./chroma
